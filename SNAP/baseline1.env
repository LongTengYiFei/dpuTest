SPDK_DIR=/home/cyf/dpuTest/SNAP/spdk

# The active BlueField-3 InfiniBand port on both hosts.
IB_IF=ibs21f1
CLIENT_CIDR=192.168.200.2/24
CLIENT_IP=192.168.200.2
TARGET_CIDR=192.168.200.3/24
TARGET_IP=192.168.200.3

# node3 /dev/nvme1n1, anchored by PCI address and serial for safety.
TARGET_BDF=0000:65:00.0
TARGET_NVME_DEV=/dev/nvme1n1
TARGET_SERIAL=PHAO332302201P9SGN

NQN=nqn.2026-09.io.spdk:node3-nvme1
TRSVCID=4420

# CPU 24 is on NUMA node 1, local to the BlueField-3 port.
SPDK_CORE_MASK=0x1000000
HUGEMEM_MB=2048
RPC_SOCK=/tmp/spdk-node3-nvmf.sock
TARGET_PID_FILE=/home/cyf/dpuTest/SNAP/run/node3-nvmf.pid
TARGET_LOG=/home/cyf/dpuTest/SNAP/run/node3-nvmf.log

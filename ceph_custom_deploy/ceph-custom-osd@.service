[Unit]
Description=Ceph custom-build object storage daemon osd.%i
Wants=network-online.target
After=network-online.target
Conflicts=ceph-osd@%i.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/local/lib/ceph/dpu:/home/cyf/ceph-dpu/build/lib:/opt/mellanox/doca/lib/x86_64-linux-gnu
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity
ExecStart=/home/cyf/ceph-dpu/build/bin/ceph-osd -f --cluster ceph --id %i --osd-data /var/lib/ceph/osd/ceph-%i --osd-class-dir /home/cyf/ceph-dpu/build/lib --run-dir /var/run/ceph --admin-socket /var/run/ceph/ceph-osd.%i.asok --pid-file /var/run/ceph/ceph-osd.%i.pid --log-file /var/log/ceph/ceph-osd.%i.log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
